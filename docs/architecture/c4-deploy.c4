specification {
  element person
  element system
  element container
  element database
  element storage
}

model {
  // AMBIENTE LOCAL (Docker Compose)
  localUser = person 'Local User' {
    description 'Desenvolvedor acessando via localhost:8080'
  }

  dockerHost = system 'Docker Host' {
    description 'Máquina local executando Docker Compose'
    technology 'Docker Engine + Docker Compose'
    
    appNetwork = system 'app-network (Bridge)' {
      description 'Rede Docker interna para comunicação entre containers'
      technology 'Docker Network'
      
      nginxContainer = container 'nginx:alpine' {
        description 'Proxy reverso (porta 8080 → backend:3000 e service-image:3000)'
        technology 'NGINX'
      }
      
      backendContainer = container 'backend:latest' {
        description 'Backend Node.js (porta 3000)'
        technology 'Node.js + Express + Sequelize'
      }
      
      imageServiceContainer = container 'service-image:latest' {
        description 'Microserviço de imagens (porta 3001→3000)'
        technology 'NestJS + Multer'
      }
      
      redisContainer = container 'redis:7-alpine' {
        description 'Cache e Pub/Sub (porta 6379)'
        technology 'Redis'
      }
      
      mainDbContainer = container 'mysql:8.0' {
        description 'Banco principal (porta 3306)'
        technology 'MySQL'
      }
      
      imageDbContainer = container 'mysql:8.0-image' {
        description 'Banco do microserviço (porta 3307→3306)'
        technology 'MySQL'
      }
      
      // Relacionamentos
      nginxContainer -> backendContainer 'Proxy /' 'HTTP'
      nginxContainer -> imageServiceContainer 'Proxy /image/' 'HTTP'
      backendContainer -> mainDbContainer 'Conecta' 'MySQL'
      backendContainer -> redisContainer 'Cache + Pub/Sub' 'Redis'
      backendContainer -> imageServiceContainer 'Delega upload' 'HTTP'
      imageServiceContainer -> imageDbContainer 'Conecta' 'MySQL'
    }
    
    volumes = system 'Docker Volumes' {
      description 'Volumes persistentes locais'
      technology 'Docker Volume'
      
      dbData = storage 'db_data' {
        description 'Dados do MySQL principal'
      }
      
      usersData = storage 'users_data' {
        description 'Dados do MySQL de imagens'
      }
      
      uploadsData = storage 'uploads' {
        description 'Arquivos de imagens enviados'
      }
      
      // Relacionamentos com volumes
      mainDbContainer -> dbData 'Persiste'
      imageDbContainer -> usersData 'Persiste'
      imageServiceContainer -> uploadsData 'Persiste'
    }
  }
  
  // AMBIENTE CLOUD (Planejado)
  cloudUser = person 'Cloud User' {
    description 'Usuário final acessando produção via HTTPS'
  }

  cloudInfra = system 'Cloud Infrastructure (Planejado)' {
    description 'Infraestrutura de produção em cloud provider'
    technology 'Render / Railway / Fly.io'
    
    reverseProxy = container 'Reverse Proxy' {
      description 'Proxy com terminação SSL/TLS'
      technology 'NGINX / Caddy'
    }
    
    backendCloud = container 'Backend Cloud' {
      description 'Backend em produção com escalabilidade horizontal'
      technology 'Node.js + Express'
    }
    
    imageServiceCloud = container 'Image Service Cloud' {
      description 'Microserviço de imagens em produção'
      technology 'NestJS'
    }
    
    redisCloud = container 'Redis Managed' {
      description 'Redis gerenciado com persistência'
      technology 'Redis Cloud / Upstash'
    }
    
    mainDbCloud = database 'MySQL Main Cloud' {
      description 'MySQL gerenciado para dados principais'
      technology 'PlanetScale / AWS RDS'
    }
    
    imageDbCloud = database 'MySQL Image Cloud' {
      description 'MySQL gerenciado para metadados de imagens'
      technology 'PlanetScale / AWS RDS'
    }
    
    cdnStorage = storage 'CDN / Object Storage' {
      description 'Armazenamento e distribuição de imagens via CDN'
      technology 'Cloudinary / AWS S3 + CloudFront'
    }
    
    observability = storage 'Observability Stack' {
      description 'Monitoramento, logs e métricas'
      technology 'Prometheus / Grafana / Datadog'
    }
    
    // Relacionamentos cloud
    reverseProxy -> backendCloud 'Roteia /' 'HTTPS'
    reverseProxy -> imageServiceCloud 'Roteia /image/' 'HTTPS'
    backendCloud -> mainDbCloud 'Conecta' 'MySQL SSL'
    backendCloud -> redisCloud 'Cache + Pub/Sub' 'Redis TLS'
    backendCloud -> imageServiceCloud 'Delega upload' 'HTTP'
    imageServiceCloud -> imageDbCloud 'Conecta' 'MySQL SSL'
    imageServiceCloud -> cdnStorage 'Upload/Serve' 'HTTP API'
    backendCloud -> observability 'Envia métricas' 'HTTP'
    imageServiceCloud -> observability 'Envia métricas' 'HTTP'
  }
  
  // Relacionamentos com usuários
  localUser -> dockerHost.appNetwork.nginxContainer 'Acessa' 'HTTP :8080'
  cloudUser -> cloudInfra.reverseProxy 'Acessa' 'HTTPS :443'
}

views {
  view localDeployment {
    title "C4 - Deploy: Deployment Diagram - Local Environment"
    description "Ambiente local Docker Compose com volumes persistentes"
    include localUser
    include dockerHost.*
    autoLayout TopBottom
  }
  
  view cloudDeployment {
    title "C4 - Deploy: Deployment Diagram - Cloud Environment (Planned)"
    description "Arquitetura planejada para produção com serviços gerenciados em cloud"
    include cloudUser
    include cloudInfra.*
    autoLayout TopBottom
  }
}
