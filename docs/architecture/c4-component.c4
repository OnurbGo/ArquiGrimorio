// --- C4 - Componentes ---
// Atualizado com Redis util, MessageBus e AdminNotificationController

specification {
  element person
  element webapp
  element mobileapp
  element gateway
  element api
  element component
  element microservice
  element database
  element cache
}

model {
  // Atores
  User = person 'User'
  admin = person 'Administrator'
  
  // Frontends
  adminWeb = webapp 'Admin Web Application'
  mobileApp = mobileapp 'Mobile Application'
  
  // Gateway
  nginx = gateway 'NGINX'
  
  // Backend API com componentes internos
  backend = api 'Backend API' {
    
    // Controllers (camada de apresentação)
    authController = component 'Login Controller' {
      description 'Gerencia login, registro e geração de tokens JWT'
      technology 'Express Controller'
    }
    
    userController = component 'User Controller' {
      description 'CRUD de usuários, upload de foto de perfil via proxy'
      technology 'Express Controller'
    }
    
    itemController = component 'Item Controller' {
      description 'CRUD de itens mágicos, delega upload de imagens ao microserviço'
      technology 'Express Controller'
    }
    
    likeController = component 'Item Like Controller' {
      description 'Gerencia curtidas (criar, remover, listar)'
      technology 'Express Controller'
    }
    
    adminController = component 'Admin Notification Controller' {
      description 'Lista notificações administrativas (eventos de criação de itens)'
      technology 'Express Controller'
    }
    
    // Middleware
    authMiddleware = component 'Auth Middleware' {
      description 'Valida tokens JWT e protege rotas'
      technology 'Express Middleware'
    }
    
    // Models (camada de dados)
    userModel = component 'User Model' {
      description 'Entidade usuário com Sequelize'
      technology 'Sequelize Model'
    }
    
    itemModel = component 'Item Model' {
      description 'Entidade item com Sequelize'
      technology 'Sequelize Model'
    }
    
    likeModel = component 'Item Like Model' {
      description 'Entidade curtida (item_like) com Sequelize'
      technology 'Sequelize Model'
    }
    
    // Utilities
    jwtUtil = component 'JWT Utility' {
      description 'Funções para gerar e validar tokens JWT'
      technology 'jsonwebtoken'
    }
    
    imageProxy = component 'Image Proxy' {
      description 'Cliente HTTP para comunicação com Image Service'
      technology 'axios'
    }
    
    redisUtil = component 'Redis Utility' {
      description 'Cliente Redis para cache e sessões'
      technology 'redis'
    }
    
    messageBus = component 'Message Bus' {
      description 'Pub/Sub para eventos assíncronos (ex: item.created)'
      technology 'Redis Pub/Sub'
    }

    // Relacionamentos internos
    authController -> jwtUtil 'Gera tokens'
    authController -> userModel 'Cria/valida usuário'
    
    authMiddleware -> jwtUtil 'Valida tokens'
    authMiddleware -> redisUtil 'Verifica sessões'
    
    userController -> authMiddleware 'Protegido por'
    userController -> userModel 'CRUD usuários'
    userController -> imageProxy 'Upload foto perfil'
    
    itemController -> authMiddleware 'Protegido por'
    itemController -> itemModel 'CRUD itens'
    itemController -> imageProxy 'Upload imagem item'
    itemController -> messageBus 'Publica item.created'
    
    likeController -> authMiddleware 'Protegido por'
    likeController -> likeModel 'CRUD curtidas'
    
    adminController -> authMiddleware 'Protegido por'
    adminController -> redisUtil 'Lê lista admin:notifications'
    
    userModel -> messageBus 'Publica eventos'
    itemModel -> messageBus 'Publica eventos'
  }
  
  // Sistemas externos ao Backend
  mainDb = database 'Main Database'
  redis = cache 'Redis Cache'
  imageService = microservice 'Image Service'
  
  // Relacionamentos externos
  User -> mobileApp 'Usa'
  admin -> adminWeb 'Usa'
  
  mobileApp -> nginx 'HTTPS'
  adminWeb -> nginx 'HTTPS'
  nginx -> backend 'HTTP'
  
  backend.userModel -> mainDb 'MySQL'
  backend.itemModel -> mainDb 'MySQL'
  backend.likeModel -> mainDb 'MySQL'
  backend.redisUtil -> redis 'Redis Protocol'
  backend.messageBus -> redis 'Redis Pub/Sub'
  backend.imageProxy -> imageService 'HTTP/REST'
}

views {
  // Visão focada nos componentes internos do Backend
  view backendComponents {
    title "C4 - Components: Backend"
    description "Componentes internos do Backend API e suas conexões com sistemas externos como banco de dados, cache e microserviço de imagens."
    
    // Inclui o container do backend e todos os seus componentes internos
    include backend.*
    
    // Inclui os sistemas externos com os quais o backend se comunica
    include mainDb, redis, imageService
    
    autoLayout TopBottom
  }

  // Visão focada na interação dos Frontends
  view frontendInteraction {
    title "C4 - Componets: Frontends"
    description "Como os atores interagem com as aplicações Frontend e como estas se conectam à API através do Gateway."
    
    // Inclui os atores, os frontends, o gateway e o backend como uma caixa preta
    include User, admin, mobileApp, adminWeb, nginx, backend
    
    autoLayout LeftRight
  }
}
